# Telegram credentials are server-only secrets. Never add NEXT_PUBLIC_ to them.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Required only when the static site and form API use different domains.
# Multiple origins can be separated with commas.
ALLOWED_ORIGIN=https://your-site.example.com
NEXT_PUBLIC_FORM_ENDPOINT=https://your-api.example.com/api/telegram
